{
  "name": "bimanyaya-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BimaNyaya - AI-Powered Insurance Grievance Redressal Platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "test": "npm run test --prefix apps/web && (cd apps/api && go test ./...) && (cd apps/ai-worker && python3 -m pytest)",
    "test:web": "npm run test --prefix apps/web",
    "test:api": "cd apps/api && go test -v ./...",
    "test:worker": "cd apps/ai-worker && python3 -m pytest -v",
    "convex:dev": "npx convex dev",
    "convex:deploy": "npx convex deploy"
  },
  "dependencies": {
    "convex": "^1.42.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}

